{
  "name": "smart-cucumber-behave",
  "publisher": "GauravWardhekar",
  "description": "Comprehensive Cucumber & Behave support for VS Code: Official Cucumber Language Server (multilingual step definitions, autocomplete, diagnostics, formatting) + Smart Behave Runner (Test Explorer, Live Run panel, CodeLens, Interactive Configuration).",
  "displayName": "Smart Cucumber-Behave",
  "version": "1.1.3",
  "license": "MIT",
  "author": "Gaurav Wardhekar <gauravwardhekar@gmail.com>",
  "contributors": [
    "SimplyTest",
    "Remo Yukoff <remo.yukoff@gmail.com>"
  ],
  "repository": {
    "url": "https://github.com/GauravWardhekara/smart-cucumber-behave.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/GauravWardhekara/smart-cucumber-behave/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "cucumber",
    "behave",
    "bdd",
    "gherkin",
    "feature",
    "python",
    "test",
    "testing",
    "runner"
  ],
  "icon": "./data/logo.png",
  "activationEvents": [
    "onLanguage:gherkin",
    "onLanguage:cucumber",
    "onLanguage:behave",
    "onLanguage:feature",
    "workspaceContains:**/*.feature",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "main": "./out/bundle.js",
  "contributes": {
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "gherkin"
        ],
        "extensions": [
          ".feature"
        ],
        "mimetypes": [
          "text/x-gherkin"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/gherkin-light.svg",
          "dark": "./media/gherkin-dark.svg"
        }
      },
      {
        "id": "cucumber",
        "aliases": [
          "Cucumber",
          "cucumber"
        ],
        "extensions": [
          ".feature"
        ],
        "mimetypes": [
          "text/x-gherkin",
          "text/x-feature",
          "text/x-cucumber"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/gherkin-light.svg",
          "dark": "./media/gherkin-dark.svg"
        }
      },
      {
        "id": "behave",
        "aliases": [
          "Behave",
          "behave"
        ],
        "extensions": [
          ".feature"
        ],
        "mimetypes": [
          "text/x-behave",
          "text/x-gherkin",
          "text/x-feature"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/gherkin-light.svg",
          "dark": "./media/gherkin-dark.svg"
        }
      },
      {
        "id": "feature",
        "aliases": [
          "Cucumber Gherkin",
          "feature",
          "Feature"
        ],
        "extensions": [
          ".feature"
        ],
        "mimetypes": [
          "text/x-gherkin",
          "text/x-feature"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/gherkin-light.svg",
          "dark": "./media/gherkin-dark.svg"
        }
      }
    ],
    "icons": {
      "behave-gherkin": {
        "description": "Gherkin Feature File Icon",
        "default": {
          "fontPath": "./media/codicons/codicon.ttf",
          "fontCharacter": "\\ea79"
        }
      },
      "behave-feature": {
        "description": "Smart Behave Feature Icon",
        "default": {
          "fontPath": "./media/codicons/codicon.ttf",
          "fontCharacter": "\\ea79"
        }
      }
    },
    "snippets": [
      {
        "language": "cucumber",
        "path": "./snippets/gherkin.json"
      },
      {
        "language": "behave",
        "path": "./snippets/gherkin.json"
      },
      {
        "language": "feature",
        "path": "./snippets/gherkin.json"
      },
      {
        "language": "gherkin",
        "path": "./snippets/gherkin.json"
      },
      {
        "language": "python",
        "path": "./snippets/python.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "behaveComment",
        "superType": "comment",
        "description": "Line comments and language pragma in .feature files"
      },
      {
        "id": "behaveStructuralKeyword",
        "superType": "keyword",
        "description": "General structural keywords in .feature files"
      },
      {
        "id": "behaveFeatureKeyword",
        "superType": "keyword",
        "description": "Feature: header keyword"
      },
      {
        "id": "behaveScenarioKeyword",
        "superType": "keyword",
        "description": "Scenario:, Scenario Outline:, Scenario Template: keywords"
      },
      {
        "id": "behaveBackgroundKeyword",
        "superType": "keyword",
        "description": "Background: header keyword"
      },
      {
        "id": "behaveExamplesKeyword",
        "superType": "keyword",
        "description": "Examples:, Scenarios: keywords"
      },
      {
        "id": "behaveRuleKeyword",
        "superType": "keyword",
        "description": "Rule: header keyword"
      },
      {
        "id": "behaveStepKeyword",
        "superType": "keyword",
        "description": "General step keywords"
      },
      {
        "id": "behaveGivenKeyword",
        "superType": "keyword",
        "description": "Given step keyword"
      },
      {
        "id": "behaveWhenKeyword",
        "superType": "keyword",
        "description": "When step keyword"
      },
      {
        "id": "behaveThenKeyword",
        "superType": "keyword",
        "description": "Then step keyword"
      },
      {
        "id": "behaveAndKeyword",
        "superType": "keyword",
        "description": "And step keyword"
      },
      {
        "id": "behaveButKeyword",
        "superType": "keyword",
        "description": "But step keyword"
      },
      {
        "id": "behaveStarKeyword",
        "superType": "keyword",
        "description": "* (wildcard) step keyword"
      },
      {
        "id": "behaveTitle",
        "superType": "class",
        "description": "Titles after structural keywords"
      },
      {
        "id": "behaveStepText",
        "superType": "string",
        "description": "Step body text"
      },
      {
        "id": "behaveDocstring",
        "superType": "string",
        "description": "Triple-quoted / fenced docstrings"
      },
      {
        "id": "behaveTable",
        "superType": "string",
        "description": "Example / data table rows"
      },
      {
        "id": "behavePlaceholder",
        "superType": "variable",
        "description": "Outline placeholders <name>"
      },
      {
        "id": "behaveTag",
        "superType": "namespace",
        "description": "Tags and decorators (@tag)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "cucumber",
        "scopes": {
          "behaveComment": [
            "comment.line.number-sign",
            "comment.line"
          ],
          "behaveStructuralKeyword": [
            "keyword.control",
            "keyword.other"
          ],
          "behaveFeatureKeyword": [
            "keyword.control.cucumber.feature",
            "keyword.control"
          ],
          "behaveScenarioKeyword": [
            "keyword.control.cucumber.scenario",
            "keyword.control"
          ],
          "behaveBackgroundKeyword": [
            "keyword.control.cucumber.background",
            "keyword.control"
          ],
          "behaveExamplesKeyword": [
            "keyword.control.cucumber.examples",
            "keyword.control"
          ],
          "behaveRuleKeyword": [
            "keyword.control.cucumber.rule",
            "keyword.control"
          ],
          "behaveStepKeyword": [
            "entity.name.function",
            "keyword.other"
          ],
          "behaveGivenKeyword": [
            "keyword.other.cucumber.given",
            "entity.name.function"
          ],
          "behaveWhenKeyword": [
            "keyword.other.cucumber.when",
            "variable.language"
          ],
          "behaveThenKeyword": [
            "keyword.other.cucumber.then",
            "support.function"
          ],
          "behaveAndKeyword": [
            "keyword.other.cucumber.and",
            "constant.language"
          ],
          "behaveButKeyword": [
            "keyword.other.cucumber.but",
            "keyword.operator"
          ],
          "behaveStarKeyword": [
            "keyword.other.cucumber.star",
            "keyword.operator"
          ],
          "behaveTitle": [
            "entity.name.type.class",
            "entity.name"
          ],
          "behaveStepText": [
            "string.unquoted",
            "markup.inserted"
          ],
          "behaveDocstring": [
            "string.quoted.docstring",
            "string.quoted"
          ],
          "behaveTable": [
            "string.other",
            "markup.inline.raw"
          ],
          "behavePlaceholder": [
            "constant.character.format.placeholder",
            "variable.other"
          ],
          "behaveTag": [
            "entity.name.tag",
            "support.variable.annotation",
            "storage.type.annotation"
          ]
        }
      },
