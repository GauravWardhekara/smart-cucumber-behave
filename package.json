    "configurationDefaults": {
      "files.associations": {
        "*.feature": "gherkin"
      },
      "[cucumber]": {
        "editor.defaultFormatter": "GauravWardhekar.smart-cucumber-behave",
        "editor.semanticHighlighting.enabled": true
      },
      "[behave]": {
        "editor.defaultFormatter": "GauravWardhekar.smart-cucumber-behave",
        "editor.semanticHighlighting.enabled": true
      },
      "[gherkin]": {
        "editor.defaultFormatter": "GauravWardhekar.smart-cucumber-behave",
        "editor.semanticHighlighting.enabled": true
      },
      "[feature]": {
        "editor.defaultFormatter": "GauravWardhekar.smart-cucumber-behave",
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "behaveFeatureKeyword": "#FFB86C",
          "behaveScenarioKeyword": "#D2A8FF",
          "behaveBackgroundKeyword": "#70E1E8",
          "behaveExamplesKeyword": "#F1FA8C",
          "behaveRuleKeyword": "#8BE9FD",
          "behaveGivenKeyword": "#7EE787",
          "behaveWhenKeyword": "#FFA657",
          "behaveThenKeyword": "#79C0FF",
          "behaveAndKeyword": "#D2A8FF",
          "behaveButKeyword": "#FF7B72",
          "behaveStarKeyword": "#A5D6FF",
          "behaveTag": "#FFA500",
          "behavePlaceholder": "#FF8DC7"
        },
        "[*Dark*]": {
          "rules": {
            "behaveFeatureKeyword": {
              "foreground": "#FFB86C",
              "bold": true
            },
            "behaveScenarioKeyword": {
              "foreground": "#D2A8FF",
              "bold": true
            },
            "behaveBackgroundKeyword": {
              "foreground": "#70E1E8",
              "bold": true
            },
            "behaveExamplesKeyword": {
              "foreground": "#F1FA8C",
              "bold": true
            },
            "behaveRuleKeyword": {
              "foreground": "#8BE9FD",
              "bold": true
            },
            "behaveGivenKeyword": {
              "foreground": "#7EE787",
              "bold": true
            },
            "behaveWhenKeyword": {
              "foreground": "#FFA657",
              "bold": true
            },
            "behaveThenKeyword": {
              "foreground": "#79C0FF",
              "bold": true
            },
            "behaveAndKeyword": {
              "foreground": "#D2A8FF",
              "bold": true
            },
            "behaveButKeyword": {
              "foreground": "#FF7B72",
              "bold": true
            },
            "behaveStarKeyword": {
              "foreground": "#A5D6FF",
              "bold": true
            },
            "behaveTag": {
              "foreground": "#FFA500",
              "bold": false
            },
            "behavePlaceholder": {
              "foreground": "#FF8DC7",
              "italic": true
            },
            "behaveStepText": "#FFFFFF",
            "behaveStepText:cucumber": "#FFFFFF",
            "behaveStepText:behave": "#FFFFFF",
            "behaveStepText:gherkin": "#FFFFFF",
            "behaveStepText:feature": "#FFFFFF"
          }
        },
        "[*Light*]": {
          "rules": {
            "behaveFeatureKeyword": {
              "foreground": "#9A6700",
              "bold": true
            },
            "behaveScenarioKeyword": {
              "foreground": "#6639BA",
              "bold": true
            },
            "behaveBackgroundKeyword": {
              "foreground": "#0598AB",
              "bold": true
            },
            "behaveExamplesKeyword": {
              "foreground": "#947600",
              "bold": true
            },
            "behaveRuleKeyword": {
              "foreground": "#218BFF",
              "bold": true
            },
            "behaveGivenKeyword": {
              "foreground": "#1A7F37",
              "bold": true
            },
            "behaveWhenKeyword": {
              "foreground": "#BF5700",
              "bold": true
            },
            "behaveThenKeyword": {
              "foreground": "#0969DA",
              "bold": true
            },
            "behaveAndKeyword": {
              "foreground": "#8250DF",
              "bold": true
            },
            "behaveButKeyword": {
              "foreground": "#CF222E",
              "bold": true
            },
            "behaveStarKeyword": {
              "foreground": "#57606A",
              "bold": true
            },
            "behaveTag": {
              "foreground": "#C85A00",
              "bold": false
            },
            "behavePlaceholder": {
              "foreground": "#BF3989",
              "italic": true
            },
            "behaveStepText": "#1a1a1a",
            "behaveStepText:cucumber": "#1a1a1a",
            "behaveStepText:behave": "#1a1a1a",
            "behaveStepText:gherkin": "#1a1a1a",
            "behaveStepText:feature": "#1a1a1a"
          }
        }
      }
